# Universe Medical Center — environment variables
# Copy to .env and fill in real values. NEVER commit the real .env file.

# ── Database (required) ──────────────────────────────────────────────
# Neon / any Postgres 14+ connection string. Use the POOLED url
# (…-pooler…neon.tech) for serverless deployments and REMOVE
# channel_binding=require (libpq-only, unsupported by Prisma).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# ── Admin panel (used by prisma/seed.ts) ─────────────────────────────
ADMIN_EMAIL="admin@universemedical.et"
ADMIN_PASSWORD="change-me-to-a-long-password"
ADMIN_NAME="Super Admin"

# ── Session signing key (required in production) ─────────────────────
# Generate: openssl rand -hex 32
SESSION_SECRET=""

# ── HMS integration (optional — see docs/HMS_INTEGRATION.md) ─────────
# Adapter id (unset = built-in LocalDbAdapter)
# HMS_ADAPTER=""
# Static API key for POST /api/v1/appointments etc. (x-api-key header)
# HMS_API_KEY=""
# Outgoing signed webhooks (HMAC-SHA256 via WEBHOOK_SECRET)
# WEBHOOK_URL=""
# WEBHOOK_SECRET=""

# ── SEO / absolute URL (optional, defaults to https://universemedical.et)
# NEXT_PUBLIC_SITE_URL="https://universemedical.et"
